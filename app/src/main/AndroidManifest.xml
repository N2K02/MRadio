<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Streams and the Radio Browser directory -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps playing with the screen off (media notification) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Installs its own updates (Android asks the user first) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MRadioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="MRadio"
        android:theme="@style/Theme.MRadio"
        android:usesCleartextTraffic="true">
        <provider android:name="com.mradio.app.CrashJournalProvider" android:authorities="${applicationId}.crashjournal" android:exported="false" android:initOrder="100" />


        <!-- Tells Android Auto this is a media app -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App-specific deep link: mradio://open?url=<encoded stream URL>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mradio" android:host="open" />
            </intent-filter>
            <!-- Verified HTTPS links used in WhatsApp shares (falls back to the website). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="n2k02.github.io"
                    android:pathPrefix="/mradio/r/" />
            </intent-filter>
            <!-- Shared radio URLs from messaging apps and browsers. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:mimeType="audio/*" />
                <data android:scheme="https" android:mimeType="audio/*" />
                <data android:scheme="http" android:mimeType="application/vnd.apple.mpegurl" />
                <data android:scheme="https" android:mimeType="application/vnd.apple.mpegurl" />
                <data android:scheme="http" android:mimeType="audio/x-mpegurl" />
                <data android:scheme="https" android:mimeType="audio/x-mpegurl" />
            </intent-filter>
            <!-- Direct audio and playlist URL extensions, including servers without MIME metadata. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" android:pathPattern=".*\\.mp3" />
                <data android:host="*" android:pathPattern=".*\\.m3u8" />
                <data android:host="*" android:pathPattern=".*\\.m3u" />
                <data android:host="*" android:pathPattern=".*\\.aac" />
                <data android:host="*" android:pathPattern=".*\\.pls" />
                <data android:host="*" android:pathPattern=".*\\.ogg" />
                <data android:host="*" android:pathPattern=".*\\.opus" />
                <data android:host="*" android:pathPattern=".*\\.flac" />
            </intent-filter>
            <!-- Known extensionless streaming hosts; do not claim every HTTPS website. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="stream.zeno.fm" />
                <data android:host="streaming.nrjaudio.fm" />
            </intent-filter>
        </activity>

        <!-- Plays the radio; also the station browser and search that Android Auto shows -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- Enables media-button delivery and Media3 playback resumption after service recreation -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- User adds this tile from Android's Quick Settings editor. -->
        <service
            android:name=".RadioQuickTileService"
            android:label="mRadio"
            android:icon="@drawable/ic_quick_radio"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Compact play / pause widget; broadcasts are explicit and app-scoped. -->
        <receiver android:name=".RadioWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/radio_widget_info" />
        </receiver>

        <!-- Restore the pending one-time alarm on reboot and alarm permission changes. -->
        <receiver
            android:name=".RadioAlarmBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Alarm receiver is explicitly targeted; not accessible to other apps. -->
        <receiver android:name=".RadioAlarmReceiver" android:exported="false" />

        <!-- Shares a downloaded update APK with Android's installer (read-only, not exported) -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
